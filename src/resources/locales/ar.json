  "View my ticket this round": "\u0639\u0631\u0636 \u062a\u0630\u0643\u0631\u062a\u064a \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062c\u0648\u0644\u0629",
  "My Prize": "\u062c\u0627\u0626\u0632\u062a\u064a",
  "Sorry, no Prizes to collect.": "\u0622\u0633\u0641\u060c \u0644\u0627 \u062a\u0648\u062c\u062f \u062c\u0648\u0627\u0626\u0632 \u0644\u062a\u062d\u0635\u064a\u0644\u0647\u0627.",
  "Claim": "\u0645\u0637\u0627\u0644\u0628\u0629",
