  "No. Matched": "\u0631\u0642\u0645. \u0645\u0637\u0627\u0628\u0642\u0629",
  "Winners": "\u0627\u0644\u0641\u0627\u0626\u0632\u0648\u0646",
  "To Burn": "\u0644\u062d\u0631\u0642",
