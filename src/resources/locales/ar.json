  "Enter Round Number to Search": "\u0623\u062f\u062e\u0644 \u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0644\u0629 \u0644\u0644\u0628\u062d\u062b",
  "View My Tickets": "\u0639\u0631\u0636 \u062a\u0630\u0627\u0643\u0631\u064a",
  "Congratulation! You have": "\u062a\u0647\u0646\u0626\u0629! \u0644\u062f\u064a\u0643",
  "winning tickets.": "\u062a\u0630\u0627\u0643\u0631 \u0627\u0644\u0641\u0648\u0632.",
  "No winning tickets. Better luck next time!": "\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0630\u0627\u0643\u0631 \u0641\u0627\u0626\u0632\u0629. \u062d\u0638\u0627 \u0623\u0641\u0636\u0644 \u0641\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629!",
  "No tickets found.": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u062a\u0630\u0627\u0643\u0631.",
