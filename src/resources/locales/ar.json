  "Win if 2,3 or 4 of your ticket numbers match!": "\u0627\u0631\u0628\u062d \u0625\u0630\u0627 \u062a\u0637\u0627\u0628\u0642 2,3 \u0623\u0648 4 \u0645\u0646 \u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u062a\u0630\u0627\u0643\u0631 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643!",
  "Stay tuned for the results!": "\u062a\u0631\u0642\u0628\u0648\u0627 \u0627\u0644\u0646\u062a\u0627\u0626\u062c!",
  "Until Lottery Draw": "\u062d\u062a\u0649 \u0633\u062d\u0628 \u0627\u0644\u064a\u0627\u0646\u0635\u064a\u0628",
